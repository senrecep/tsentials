{
  "name": "tsentials",
  "version": "3.1.0",
  "description": "Railway-oriented programming for TypeScript — Result<T>, Maybe<T>, Rule Engine, and DDD base classes with full async pipeline support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "import": "./dist/result/index.js"
    },
    "./maybe": {
      "types": "./dist/maybe/index.d.ts",
      "import": "./dist/maybe/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./entity": {
      "types": "./dist/entity/index.d.ts",
      "import": "./dist/entity/index.js"
    },
    "./time": {
      "types": "./dist/time/index.d.ts",
      "import": "./dist/time/index.js"
    },
    "./clone": {
      "types": "./dist/clone/index.d.ts",
      "import": "./dist/clone/index.js"
    },
    "./union": {
      "types": "./dist/union/index.d.ts",
      "import": "./dist/union/index.js"
    },
    "./json": {
      "types": "./dist/json/index.d.ts",
      "import": "./dist/json/index.js"
    },
    "./function": {
      "types": "./dist/function/index.d.ts",
      "import": "./dist/function/index.js"
    },
    "./eq": {
      "types": "./dist/eq/index.d.ts",
      "import": "./dist/eq/index.js"
    },
    "./predicate": {
      "types": "./dist/predicate/index.d.ts",
      "import": "./dist/predicate/index.js"
    },
    "./array": {
      "types": "./dist/array/index.d.ts",
      "import": "./dist/array/index.js"
    },
    "./ord": {
      "types": "./dist/ord/index.d.ts",
      "import": "./dist/ord/index.js"
    },
    "./these": {
      "types": "./dist/these/index.d.ts",
      "import": "./dist/these/index.js"
    },
    "./tree": {
      "types": "./dist/tree/index.d.ts",
      "import": "./dist/tree/index.js"
    },
    "./record": {
      "types": "./dist/record/index.d.ts",
      "import": "./dist/record/index.js"
    },
    "./string": {
      "types": "./dist/string/index.d.ts",
      "import": "./dist/string/index.js"
    },
    "./uuid": {
      "types": "./dist/uuid/index.d.ts",
      "import": "./dist/uuid/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    },
    "./resilience": {
      "types": "./dist/resilience/index.d.ts",
      "import": "./dist/resilience/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "import": "./dist/pagination/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "import": "./dist/enums/index.js"
    },
    "./mediator": {
      "types": "./dist/mediator/index.d.ts",
      "import": "./dist/mediator/index.js"
    },
    "./idempotency": {
      "types": "./dist/idempotency/index.d.ts",
      "import": "./dist/idempotency/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests",
    "lint:fix": "biome lint --write src tests",
    "format": "biome format --write src tests",
    "check": "biome check src tests",
    "prepublishOnly": "npm run build && npm test",
    "docs7": "node scripts/docs7.mjs",
    "docs7:check": "node scripts/docs7.mjs --check",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "check:package": "node scripts/check-package.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs/BEHAVIOUR-CHANGES.md",
    "docs/IDEMPOTENCY.md",
    ".well-known/agent-skills",
    "LICENSE"
  ],
  "keywords": [
    "result",
    "maybe",
    "option",
    "railway-oriented-programming",
    "functional",
    "error-handling",
    "ddd",
    "domain-driven-design",
    "rule-engine",
    "monad",
    "typescript",
    "async",
    "pipeline"
  ],
  "license": "MIT",
  "author": {
    "name": "Recep Şen",
    "email": "me@senrecep.com",
    "url": "https://github.com/senrecep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senrecep/tsentials.git"
  },
  "homepage": "https://senrecep.github.io/tsentials/",
  "bugs": {
    "url": "https://github.com/senrecep/tsentials/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
